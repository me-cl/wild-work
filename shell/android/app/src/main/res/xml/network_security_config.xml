<?xml version="1.0" encoding="utf-8"?>
<!--
  为什么需要这份配置：Android 9（API 28）起默认禁止明文 HTTP。面板是 WebView 加载
  http://127.0.0.1:<port>/（Go 侧起的是普通 http.Server，没上 TLS），不加白名单就是
  一屏 ERR_CLEARTEXT_NOT_PERMITTED。

  白名单只开环回：上游 API 调用走 Go 的 http.Client，根本不经过 Android 的
  network security config，所以放开到全域没有任何收益，只会让 WebView 侧的
  误配置更难被发现。
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
